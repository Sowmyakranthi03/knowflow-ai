APP_NAME=KnowFlow AI
APP_VERSION=0.4.0
APP_DESCRIPTION=Enterprise knowledge assistant powered by retrieval-augmented generation.

ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

MAX_UPLOAD_SIZE_MB=10
UPLOAD_CHUNK_SIZE_BYTES=1048576
MAX_EXTRACTED_CHARACTERS=5000000

CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=30
MIN_CHUNK_SIZE_WORDS=40
MAX_CHUNKS_PER_DOCUMENT=10000